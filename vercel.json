{
  "rewrites": [
    {
      "source": "/pay/:token",
      "destination": "/api/pay?token=:token"
    },
    {
      "source": "/quote/:token",
      "destination": "/api/quote-portal?token=:token"
    },
    {
      "source": "/e/:slug",
      "destination": "/api/estimate-page?slug=:slug"
    }
  ]
}
